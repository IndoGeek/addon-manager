#!/usr/bin/env bash
#
# Pre-push gate for the Addon Manager extension: runs the same checks CI does
# (PHP syntax lint, the static dead-catch audit, every test suite) so a broken
# push never leaves the machine.
#
# Install:  mi install-hooks
# Remove:   mi install-hooks --remove
# Bypass once (emergencies only):
#           MI_SKIP_CHECKS=1 git push
#
# The hook is symlinked into .git/hooks, so editing this file is enough.
set -uo pipefail

if [ "${MI_SKIP_CHECKS:-0}" = "1" ]; then
  echo "pre-push: checks skipped (MI_SKIP_CHECKS=1)"
  exit 0
fi

# .git/hooks/pre-push -> <repo>/tools/hooks/pre-push, so the repo root is two
# levels up from the symlink's directory in both layouts.
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

if [ ! -d "$root/tests/manual" ]; then
  echo "pre-push: not the extension repository — skipping" >&2
  exit 0
fi

echo "pre-push: checking $(basename "$root") before it leaves this machine"

if [ -x "$root/mi" ]; then
  "$root/mi" check
  status=$?
elif [ -f "$root/tools/audit-php.php" ]; then
  php "$root/tools/audit-php.php" "$root/app"
  status=$?
else
  echo "pre-push: no checks available (mi and the audit tool are missing)" >&2
  exit 0
fi

if [ "$status" -ne 0 ]; then
  cat >&2 <<'EOF'

pre-push: checks failed — the push was stopped.
  Re-run for detail:   mi check
  Audit only:          mi audit
  Push anyway:         MI_SKIP_CHECKS=1 git push

EOF
  exit "$status"
fi

echo "pre-push: all checks passed"
