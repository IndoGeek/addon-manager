#!/usr/bin/env bash
# mi — developer CLI for the Addon Manager Blueprint extension.
set -uo pipefail

SRC="${BASH_SOURCE[0]}"
# Resolve symlinks (e.g. /usr/local/bin/mi -> repo/mi) so the CLI works from anywhere with no setup.
while [ -L "$SRC" ]; do
  DIR="$(cd -P "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  [[ $SRC != /* ]] && SRC="$DIR/$SRC"
done
SRC="$(cd -P "$(dirname "$SRC")" && pwd)"
cd "$SRC" || exit 1

# ───────────────────────────── arg helpers ───────────────────────── Tiny, dependency-free flag parsing...
arg_has() { # arg_has <flag> <args...> → true when the flag is present
  local needle="$1"; shift
  local a
  for a in "$@"; do [ "$a" = "$needle" ] && return 0; done
  return 1
}

arg_val() { # arg_val <flag> <args...> → value of "--flag=v" or "--flag v"
  local needle="$1"; shift
  while [ "$#" -gt 0 ]; do
    case "$1" in
      "$needle") printf '%s' "${2:-}"; return 0 ;;
      "$needle"=*) printf '%s' "${1#*=}"; return 0 ;;
    esac
    shift
  done
  return 1
}

arg_pos() { # arg_pos <args...> → first non-option argument (skips option values)
  local skip=0 a
  for a in "$@"; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    case "$a" in
      --filter|--only|--min|--url|--panel-dir|--jobs) skip=1; continue ;;
      -*) continue ;;
      *) printf '%s' "$a"; return 0 ;;
    esac
  done
  return 1
}

# Stage filter shared by `mi lint --only <stage>` and `mi check --only <cmd>`.
ONLY_STAGE=""
stage_wanted() { [ -z "$ONLY_STAGE" ] || [ "$ONLY_STAGE" = "$1" ]; }

# ───────────────────────────── UI helpers ──────────────────────────
if [ -t 1 ]; then
  C_RESET=$'\e[0m';  C_DIM=$'\e[2m';   C_BOLD=$'\e[1m'
  C_GREEN=$'\e[38;5;114m'; C_CYAN=$'\e[38;5;81m'
  C_YELLOW=$'\e[38;5;179m'; C_RED=$'\e[38;5;203m'
  C_BLUE=$'\e[38;5;75m'
  TTY=1
else
  C_RESET=""; C_DIM=""; C_BOLD=""; C_GREEN=""; C_CYAN=""
  C_YELLOW=""; C_RED=""; C_BLUE=""
  TTY=0
fi

color_off() {
  C_RESET=""; C_DIM=""; C_BOLD=""; C_GREEN=""
  C_CYAN=""; C_YELLOW=""; C_RED=""; C_BLUE=""
  TTY=0   # also drops the in-place progress bar, so logs stay line-per-event
}

# Plain output for CI logs and redirects: the standard NO_COLOR env var, or --no-color anywhere on the command...
if [ -n "${NO_COLOR:-}" ] || arg_has --no-color "$@"; then
  color_off
fi

SPIN_FRAMES=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
BAR_WIDTH=22

cleanup_tty() {
  if [ "$TTY" = 1 ]; then
    printf '\r\e[2K\e[?25h'
  fi
}
trap cleanup_tty EXIT
trap 'cleanup_tty; exit 130' INT TERM

info()  { printf '%s[..]%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
ok()    { printf '%s[ok]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
# Success line for in-progress checks (smoke): silent under --quiet/--json so only failures and the...
okq()   { if [ "${QUIET:-0}" = 0 ] && [ "${JSON:-0}" = 0 ]; then ok "$*"; fi; }
warn()  { printf '%s[!!]%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
die()   { cleanup_tty; printf '%s[!!]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

bar_glyphs() { # $1 = 0..1000, $2 = spin frame
  local ratio=$(( $1 * BAR_WIDTH / 1000 )) out="" i
  for ((i = 0; i < BAR_WIDTH; i++)); do
    if (( i < ratio )); then out+="${C_GREEN}█"
    elif (( i == ratio && $1 < 1000 )); then out+="${C_YELLOW}${SPIN_FRAMES[$(($2 % ${#SPIN_FRAMES[@]}))]}"
    else out+="${C_DIM}░"
    fi
  done
  printf '%s%s' "$out" "$C_RESET"
}

# One-line in-place progress: bar + counts + current item
draw() { # $1=done $2=total $3=frame $4=current-label
  local prog=0
  (( $2 > 0 )) && prog=$(( $1 * 1000 / $2 ))
  printf '\r\e[2K %s %s%3d%%%s %s%s/%s%s %s' \
    "$(bar_glyphs "$prog" "$3")" "$C_BOLD" $(( prog / 10 )) "$C_RESET" \
    "$C_BOLD" "$1" "$2" "$C_RESET" "${4:-}"
}

# ───────────────────────────── mi test ───────────────────────────── Machine-readable summary for CI...
print_test_json() {
  local passed="$1" failed="$2" secs="$3"; shift 3
  local rows=("$@") row name rest status dur first=1
  printf '{"passed":%s,"failed":%s,"seconds":%s,"suites":[' "$passed" "$failed" "$secs"
  for row in "${rows[@]}"; do
    name="${row%%|*}"; rest="${row#*|}"
    status="${rest%%|*}"; dur="${rest#*|}"
    [ "$first" = 1 ] || printf ','
    first=0
    printf '{"name":"%s","status":"%s","seconds":%s}' \
      "$name" "$([ "$status" = 0 ] && echo passed || echo failed)" "$dur"
  done
  printf ']}\n'
}

cmd_test() {
  local filter list_only=0 bail=0 show_full=0
  local json_rows=()
  filter="$(arg_val --filter "$@" || true)"
  [ -n "$filter" ] || filter="$(arg_pos "$@" || true)"
  filter="${filter:-all}"
  if arg_has --list "$@" || arg_has -l "$@"; then list_only=1; fi
  if arg_has --bail "$@" || arg_has -x "$@"; then bail=1; fi
  if arg_has --verbose "$@" || arg_has -v "$@"; then show_full=1; fi

  # Collect suites (a suite is one runnable file in tests/manual)
  local suites=()
  while IFS= read -r f; do suites+=("$f"); done < <(
    find "$SRC/tests/manual" -maxdepth 1 -name '*.php' -type f | sort
  )

  [ "${#suites[@]}" -gt 0 ] || die "No test suites found in tests/manual."

  local runnable=()
  if [ "$filter" != "all" ]; then
    local s
    for s in "${suites[@]}"; do
      [[ "$(basename "$s")" == *"$filter"* ]] && runnable+=("$s")
    done
    [ "${#runnable[@]}" -gt 0 ] || die "No suite matches '$filter'."
  else
    runnable=("${suites[@]}")
  fi

  if [ "$list_only" = 1 ]; then
    local s n
    for s in "${runnable[@]}"; do
      n="$(basename "$s" -test.php)"; n="$(basename "$n" .php)"
      printf '%s\n' "$n"
    done
    printf '%s%d suite(s)%s\n' "$C_DIM" "${#runnable[@]}" "$C_RESET" >&2
    return 0
  fi

  local total=${#runnable[@]}
  local passed=0 failed=0 skipped=0
  local failures=() timings=()
  local log logdir
  logdir="$(mktemp -d)"

  if [ "$QUIET" = 0 ] && [ "$JSON" = 0 ]; then
    printf '%s▲%s %smi test%s — %s%d%s suite%s (%s)\n\n' \
      "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" \
      "$C_DIM" "$total" "$C_RESET" \
      "$([ "$total" = 1 ] && echo '' || echo 's')" "$filter"
  fi

  local i=0 frame=0 t0=$SECONDS
  for suite in "${runnable[@]}"; do
    local name
    name="$(basename "$suite" -test.php)"
    name="$(basename "$name" .php)"
    i=$(( i + 1 ))

    log="$logdir/$name.log"

    if [ "$QUIET" = 0 ] && [ "$JSON" = 0 ]; then
      if [ "$TTY" = 1 ]; then
        draw "$(( i - 1 ))" "$total" "$frame" \
          "${C_CYAN}▶${C_RESET} $name"
      else
        printf '%s▸%s %d/%d · %s\n' "$C_BLUE" "$C_RESET" "$i" "$total" "$name"
      fi
    fi

    local start=$SECONDS
    php "$suite" >"$log" 2>&1
    local status=$?
    local dur=$(( SECONDS - start ))
    json_rows+=("$name|$status|$dur")

    if [ "$status" -eq 0 ]; then
      passed=$(( passed + 1 ))
      timings+=("ok $name (${dur}s)")
    else
      failed=$(( failed + 1 ))
      failures+=("$name:$log")
      timings+=("fail $name (${dur}s)")
      if [ "$bail" = 1 ]; then
        cleanup_tty
        printf '\n'
        printf '  %s✗ bail — stopping after the first failure (%s)%s\n' \
          "$C_RED" "$name" "$C_RESET" >&2
        printf '  %sfull output: %s%s\n' "$C_DIM" "$log" "$C_RESET" >&2
        exit 1
      fi
    fi

    if [ "$TTY" = 1 ] && [ "$QUIET" = 0 ] && [ "$JSON" = 0 ]; then
      frame=$(( frame + 2 ))
      # tick summary: keep the line calm — only counts change
      draw "$i" "$total" "$frame" ""
      printf '' # no newline; next draw overwrites
    fi
  done

  cleanup_tty
  [ "$JSON" = 1 ] || printf '\n'

  # Per-suite results — compact: one glyph line per suite, details only on fail. --quiet keeps the failures...
  local entry
  for entry in "${timings[@]}"; do
    if [[ "$entry" == ok* ]]; then
      if [ "$JSON" = 0 ] && [ "$QUIET" = 0 ]; then
        printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "${entry#ok }"
      fi
    else
      [ "$JSON" = 0 ] && printf '  %s✗%s %s\n' "$C_RED" "$C_RESET" "${entry#fail }"
    fi
  done

  # Failure details (stderr in JSON mode so stdout stays a single JSON object)
  if [ "${#failures[@]}" -gt 0 ]; then
    local pair
    if [ "$JSON" = 1 ]; then
      for pair in "${failures[@]}"; do
        printf 'test failed: %s -> %s\n' "${pair%%:*}" "${pair#*:}" >&2
      done
    else
      printf '\n%s── failures ───────────────────────────%s\n' "$C_RED" "$C_RESET"
      for pair in "${failures[@]}"; do
        local fname="${pair%%:*}" flog="${pair#*:}"
        printf '\n%s✗ %s%s\n' "$C_RED" "$fname" "$C_RESET"
        tail -n "$([ "$show_full" = 1 ] && echo 200 || echo 12)" "$flog" | sed 's/^/    /'
      done
      printf '\n%sfull output:%s %s/<name>.log\n' "$C_DIM" "$C_RESET" "$logdir"
    fi
  else
    rm -rf "$logdir"
  fi

  local total_dur=$(( SECONDS - t0 ))
  if [ "$JSON" = 1 ]; then
    print_test_json "$passed" "$failed" "$total_dur" "${json_rows[@]}"
  else
    printf '\n%s── summary ────────────────────────────%s\n' "$C_DIM" "$C_RESET"
    printf '  %s✓ %d passed%s  %s✗ %d failed%s  %s%d skipped%s  %s◷ %ds%s\n' \
      "$C_GREEN" "$passed" "$C_RESET" \
      "$C_RED" "$failed" "$C_RESET" \
      "$C_DIM" "$skipped" "$C_RESET" \
      "$C_BLUE" "$total_dur" "$C_RESET"
  fi

  [ "$failed" -eq 0 ] || exit 1
}

# ───────────────────────────── mi lint ─────────────────────────────
cmd_lint() {
  local fix=0 skip_ts=0 only=""
  if arg_has --fix "$@" || arg_has fix "$@"; then fix=1; fi
  if arg_has --no-ts "$@" || arg_has --no-typescript "$@"; then skip_ts=1; fi
  only="$(arg_val --only "$@" || true)"
  case "$only" in
    ""|syntax|blade|style|ts|typescript) ;;
    *) die "mi lint --only expects syntax|blade|style|ts (got '$only')" ;;
  esac
  [ "$only" = "typescript" ] && only="ts"
  ONLY_STAGE="$only"

  local php_files=()
  while IFS= read -r f; do php_files+=("$f"); done < <(
    find "$SRC/app" "$SRC/config" "$SRC/tests" -name '*.php' -type f | sort
  )

  printf '%s▲%s %smi lint%s — %d PHP files\n\n' \
    "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "${#php_files[@]}"

  local failed=0 f fcount=0
  if stage_wanted syntax; then
  for f in "${php_files[@]}"; do
    fcount=$(( fcount + 1 ))
    [ "$TTY" = 1 ] && printf '\r\e[2K %s scanning %s' "$C_DIM" "$(basename "$f")$C_RESET"
    php -l "$f" >/dev/null 2>&1 || {
      failed=$(( failed + 1 ))
      printf '\n'
      warn "syntax: $(realpath --relative-to="$SRC" "$f")"
      php -l "$f" 2>&1 | tail -2 | sed 's/^/    /'
    }
  done
  [ "$TTY" = 1 ] && printf '\r\e[2K'
  ok "syntax scan: $fcount files${failed:+, ${C_RED}$failed failed${C_RESET}}"
  fi

  # Blade compile check: compile with the panel's real BladeCompiler, then php -l the generated PHP.
  local panel="/var/www/pterodactyl"
  if stage_wanted blade; then
  if [ -f "$panel/vendor/autoload.php" ] && [ -f "$SRC/view.blade.php" ]; then
    local tmpc="/tmp/mi_blade_lint.php"
    # The installed copy is Blueprint's header with our view appended; a rebuild can invalidate it in ways the repo source cannot show.
    local tmpi="/tmp/mi_blade_lint_installed.php"
    local installed_view="$panel/resources/views/admin/extensions/modpackinstaller/index.blade.php"
    if sudo -n php -r '
require "'"$panel"'/vendor/autoload.php";
$blade = new Illuminate\View\Compilers\BladeCompiler(new Illuminate\Filesystem\Filesystem, sys_get_temp_dir()."/mi-compiled");
file_put_contents("'"$tmpc"'", $blade->compileString(file_get_contents("'"$SRC"'/view.blade.php")));
$installed = "'"$installed_view"'";
if (is_file($installed)) {
    file_put_contents("'"$tmpi"'", $blade->compileString(file_get_contents($installed)));
}
' >/dev/null 2>&1 && php -l "$tmpc" >/dev/null 2>&1; then
      ok "blade: view.blade.php compiles"
      sudo -n rm -f "$tmpc" 2>/dev/null || rm -f "$tmpc" 2>/dev/null || true
    else
      failed=$(( failed + 1 ))
      warn "blade: view.blade.php does not compile"
      php -l "$tmpc" 2>&1 | tail -2 | sed 's/^/    /'
    fi

    # What the panel actually renders, so a broken rebuild is caught here instead of on the settings page.
    if [ -f "$installed_view" ]; then
      if php -l "$tmpi" >/dev/null 2>&1; then
        ok "blade: installed admin view compiles"
      else
        failed=$(( failed + 1 ))
        warn "blade: the installed admin view is broken — run 'mi build' to regenerate it"
        php -l "$tmpi" 2>&1 | tail -2 | sed 's/^/    /'
      fi
    fi

    sudo -n rm -f "$tmpi" 2>/dev/null || rm -f "$tmpi" 2>/dev/null || true
  else
    warn "blade check skipped (panel vendor dir not found)"
  fi
  fi

  # Style lint via php-cs-fixer when available
  if stage_wanted style; then
  if [ -x "$SRC/vendor/bin/php-cs-fixer" ]; then
    if [ "$fix" = 1 ]; then
      "$SRC/vendor/bin/php-cs-fixer fix" >/dev/null 2>&1
      ok "style: fixed (php-cs-fixer)"
    else
      if "$SRC/vendor/bin/php-cs-fixer fix" --dry-run --diff >/dev/null 2>&1; then
        ok "style: clean (php-cs-fixer)"
      else
        failed=$(( failed + 1 ))
        warn "style: issues found — run 'mi lint --fix'"
      fi
    fi
  else
    warn "style: php-cs-fixer not installed (skipped)"
  fi
  fi

  # Frontend typecheck: catches TS regressions before the panel's slow yarn build does.
  if stage_wanted ts && [ "$skip_ts" = 0 ]; then
  if [ -d "$SRC/node_modules/typescript" ] || command -v npx >/dev/null 2>&1; then
    local ts_out ts_status
    ts_out="$(cd "$SRC" && npx tsc --noEmit --jsx react-jsx --esModuleInterop \
      --module esnext --moduleResolution bundler --target es2020 \
      --skipLibCheck --strict false components/ModpackInstaller.tsx 2>&1 \
      | grep -v '^npm notice')"
    # tsc exit code is lost through the grep pipe; re-derive from output
    if [ -z "$ts_out" ]; then ts_status=0; else ts_status=1; fi
    if [ "$ts_status" -eq 0 ]; then
      ok "typescript: components typecheck clean"
    elif printf '%s' "$ts_out" | grep -q "error TS2307.*axios" \
      && [ -z "$(printf '%s' "$ts_out" | grep -v 'error TS2307.*axios')" ]; then
      warn "typescript: only missing axios types (panel-provided in prod) — skipped"
    else
      failed=$(( failed + 1 ))
      warn "typescript: errors found"
      printf '%s\n' "$ts_out" | head -10 | sed 's/^/    /'
    fi
  else
    warn "typescript: npx not available (skipped)"
  fi
  fi

  if [ "$failed" -gt 0 ]; then
    die "lint failed with $failed issue(s)."
  fi
  ok "lint passed${ONLY_STAGE:+ (only: $ONLY_STAGE)}"
  ONLY_STAGE=""
}

# ───────────────────────────── mi audit ─────────────────────────── Static check for dead catch clauses: a...
cmd_audit() {
  [ -f "$SRC/tools/audit-php.php" ] || die "tools/audit-php.php not found."

  local paths=("$@")
  [ "${#paths[@]}" -gt 0 ] || paths=("app")

  php "$SRC/tools/audit-php.php" "${paths[@]}"
}

# ───────────────────────────── hook toggles ────────────────── Hook switches live in .git/config, so they are per-clone...
hook_cfg() { # hook_cfg checks|bump → true|false, default true when unset
  local v
  v="$(git config --get "mi.hooks.$1" 2>/dev/null || true)"
  case "${v,,}" in
    false|off|no|0) printf 'false' ;;
    *) printf 'true' ;;
  esac
}

hook_cfg_set() { # hook_cfg_set checks|bump on|off
  local name="$1" value="$2"
  case "${value,,}" in
    on|true|yes|enable|enabled|1)     git config "mi.hooks.$name" true  || die "could not write mi.hooks.$name." ;;
    off|false|no|disable|disabled|0)  git config "mi.hooks.$name" false || die "could not write mi.hooks.$name." ;;
    *) die "mi hooks $name expects on or off (got '$value')." ;;
  esac
}

# ───────────────────────────── mi install-hooks ────────────── Symlinks the versioned hooks in tools/hooks...
cmd_hooks() {
  local action="${1:-status}"
  local hooks_dir="$SRC/tools/hooks"

  if [ "$action" = "status" ] || [ "$action" = "show" ]; then
    [ -d .git ] || die "Not a git repository."

    printf '%s▲%s %smi hooks%s\n\n' \
      "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET"

    local checks bump
    checks="$(hook_cfg checks)"
    bump="$(hook_cfg bump)"

    local linked="${C_GREEN}installed${C_RESET} ${C_DIM}.git/hooks/pre-push${C_RESET}"
    if [ ! -e .git/hooks/pre-push ]; then
      linked="${C_YELLOW}not installed${C_RESET} ${C_DIM}run: mi hooks install${C_RESET}"
    fi

    local on="${C_GREEN}on ${C_RESET}" off="${C_YELLOW}off${C_RESET}"
    local mark_checks="$off" mark_bump="$off"
    [ "$checks" = true ] && mark_checks="$on"
    [ "$bump" = true ] && mark_bump="$on"

    printf '  %-18s %s\n' "pre-push hook" "$linked"
    printf '  %-18s %s  %slint + audit + test before every push%s\n' \
      "checks" "$mark_checks" "$C_DIM" "$C_RESET"
    printf '  %-18s %s  %sfeat→minor · fix→patch · chore→major%s\n' \
      "version bump" "$mark_bump" "$C_DIM" "$C_RESET"
    printf '\n%schange a toggle:  mi hooks checks off · mi hooks bump off%s\n' "$C_DIM" "$C_RESET"
    printf '%sskip one push:    git -c mi.hooks.bump=false push   (or MI_SKIP_BUMP=1)%s\n' "$C_DIM" "$C_RESET"

    return 0
  fi

  if [ "$action" = "checks" ] || [ "$action" = "bump" ]; then
    [ -d .git ] || die "Not a git repository."
    hook_cfg_set "$action" "${2:-}"
    ok "mi.hooks.$action = $(hook_cfg "$action")"

    if [ "$action" = "checks" ] && [ "$(hook_cfg checks)" = true ] && [ ! -e .git/hooks/pre-push ]; then
      info "the hook is not linked yet — install it with: mi hooks install"
    fi

    return 0
  fi

  if [ "$action" = "remove" ] || [ "$action" = "uninstall" ] || [ "$action" = "--remove" ]; then
    [ -d .git ] || die "Not a git repository."

    local hook name removed=0
    for hook in "$hooks_dir"/*; do
      [ -e "$hook" ] || continue
      name="$(basename "$hook")"

      if [ -e ".git/hooks/$name" ] || [ -L ".git/hooks/$name" ]; then
        rm -f ".git/hooks/$name"
        ok "removed .git/hooks/$name"
        removed=$(( removed + 1 ))
      fi
    done

    [ "$removed" -gt 0 ] || warn "no installed hooks to remove"
    return 0
  fi

  [ -d .git ] || die "Not a git repository — run this inside the checkout."
  [ -d "$hooks_dir" ] || die "tools/hooks not found."

  printf '%s▲%s %smi hooks install%s\n\n' \
    "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET"

  local hook name
  for hook in "$hooks_dir"/*; do
    [ -f "$hook" ] || continue
    name="$(basename "$hook")"
    chmod +x "$hook"
    ln -sf "$hook" ".git/hooks/$name"
    ok "$name -> .git/hooks/$name"
  done

  ok "checks: $(hook_cfg checks) · version bump: $(hook_cfg bump)"
  info "toggle with: mi hooks checks off · mi hooks bump off  (mi hooks for status)"
  info "skip one push with MI_SKIP_CHECKS=1 / MI_SKIP_BUMP=1 or git -c mi.hooks.bump=false push"
}

# ───────────────────────────── mi check ──────────────────────────── The pre-push gate: lint → audit → every...
cmd_check() {
  local fast=0 only="" extra=()
  if arg_has --fast "$@" || arg_has -F "$@"; then fast=1; fi
  only="$(arg_val --only "$@" || true)"
  case "$only" in
    ""|lint|audit|test) ;;
    *) die "mi check --only expects lint|audit|test (got '$only')" ;;
  esac
  if [ "$JSON" = 1 ]; then extra=(--json); fi
  if [ "$fast" = 1 ] && [ "$only" = "" ]; then
    info "--fast: lint + audit only (test suites skipped)"
  fi

  if [ "$only" = "" ] || [ "$only" = lint ]; then
    cmd_lint
    [ "$JSON" = 1 ] || printf '\n'
  fi

  if [ "$only" = "" ] || [ "$only" = audit ]; then
    cmd_audit app ${extra[@]+"${extra[@]}"} \
      || die "audit failed — fix the reported catch clause(s)."
    [ "$JSON" = 1 ] || printf '\n'
  fi

  if [ "$fast" = 0 ] && { [ "$only" = "" ] || [ "$only" = test ]; }; then
    cmd_test all ${extra[@]+"${extra[@]}"}
  fi
}

# ───────────────────────────── mi build / css ────────────────── Detects which panel layout we're working...
panel_dir() {
  # repo sits inside a panel? (resolve, so no trailing /.. in the path)
  if [ -f "$SRC/../artisan" ] && [ -f "$SRC/../blueprint.sh" ]; then
    ( cd "$SRC/.." && pwd )
    return 0
  fi
  # standard local-dev location?
  if [ -f "/var/www/pterodactyl/artisan" ]; then
    echo "/var/www/pterodactyl"
    return 0
  fi
  return 1
}

in_panel_dev_tree() {
  case "$SRC" in
    */.blueprint/dev|*/.blueprint/dev/*) return 0 ;;
    *) return 1 ;;
  esac
}

# The identifier conf.yml registers the extension under.
conf_identifier() {
  sed -n 's/^[[:space:]]*identifier:[[:space:]]*"\([^"]*\)".*/\1/p' "$SRC/conf.yml" | head -1
}

# Is the extension in the panel's Blueprint install list? `mi remove` takes it back out, so every command that
# writes into the installed tree needs to know the answer.
extension_installed() { # $1 = panel
  local identifier
  identifier="$(conf_identifier)"
  [ -n "$identifier" ] || return 1
  sudo -n grep -qF "|$identifier," \
    "$1/.blueprint/extensions/blueprint/private/db/installed_extensions" 2>/dev/null
}

# A build interrupted right after it started (Ctrl+C, a killed terminal, a timeout) leaves Blueprint's lock file
# behind, and the next blueprint command then waits on it forever. Warn instead of hanging silently; never delete the
# lock ourselves, since a concurrent build may genuinely hold it.
warn_stale_blueprint_lock() { # $1 = panel
  local lock="$1/.blueprint/lock" reply=""
  [ -f "$lock" ] || return 0
  [ -n "$(sudo -n find "$lock" -mmin +2 -print 2>/dev/null)" ] || return 0

  warn "stale Blueprint lock from an interrupted build: $lock"
  warn "Blueprint waits on that file forever, so nothing would build."

  if [ "$TTY" = 1 ] && [ -r /dev/tty ]; then
    printf '%s[??]%s Clear it now? (y/N) ' "$C_YELLOW" "$C_RESET"
    read -r reply < /dev/tty
    case "$reply" in
      y|Y|yes|YES)
        ( cd "$1" && sudo -n blueprint -unlock ) && ok "lock cleared"
        ;;
      *) warn "left it in place — clear it with: sudo blueprint -unlock" ;;
    esac
  else
    warn "clear it with: sudo blueprint -unlock"
  fi
}

# `mi build [-n|--dry-run] [--css-only]` -n show which layout/target would be used, then stop --css-only...
cmd_build() {
  local panel dry=0
  if arg_has --dry-run "$@" || arg_has -n "$@"; then dry=1; fi

  if arg_has --css-only "$@"; then
    cmd_css
    return 0
  fi

  if in_panel_dev_tree; then
    # .blueprint/dev holds the extension directly (Blueprint packages that dir as-is), so strip from the first...
    panel="${SRC%%/.blueprint/dev*}"

    if [ "$dry" = 1 ]; then
      info "layout:   panel dev tree"
      info "source:   $SRC"
      info "panel:    $panel"
      info "steps:    css rebuild → sync admin files → blueprint -build"
      return 0
    fi

    info "Dev-tree deploy (working directly inside the panel)"

    node "$SRC/tools/build-css.mjs" || die "css build failed."

    sync_admin_files "$panel"

    warn_stale_blueprint_lock "$panel"

    cd "$panel" || die "Panel directory disappeared."
    sudo -n blueprint -build || die "blueprint -build failed."

    ok "deployed from dev tree — hard-refresh the panel"
    return 0
  fi

  if panel=$(panel_dir); then
    if [ "$dry" = 1 ]; then
      info "layout:   repo checkout"
      info "source:   $SRC"
      info "panel:    $panel"
      info "steps:    tools/build.sh rsync pipeline → blueprint -build"
      extension_installed "$panel" \
        || info "note:     not installed in this panel yet — the installer would run first"
      return 0
    fi

    warn_stale_blueprint_lock "$panel"

    # The rsync pipeline writes into the installed extension tree, which does not exist (and has no component wiring)
    # on a panel that never installed the extension or had it removed — install it first, then sync on top.
    if ! extension_installed "$panel"; then
      info "extension is not installed in $panel — installing it first"
      # MI_SKIP_SYNC: the installer's own post-install sync would duplicate the build this command runs next.
      env PANEL_DIR="$panel" MI_SKIP_SYNC=1 bash "$SRC/tools/installer.sh" || die "install failed."
    fi

    info "Deploying from repo checkout to panel at $panel"
    # pass the detected panel explicitly — tools/build.sh defaults to /var/www/pterodactyl otherwise, which is...
    exec env PANEL_DIR="$panel" bash "$SRC/tools/build.sh"
  fi

  die "No Pterodactyl panel found. Run from the repo or the panel dev tree."
}

# Copies the admin-page files Blueprint only places at install time (view, controller, conf, admin css) from...
sync_admin_files() {
  local panel="$1"
  local identifier
  identifier="$(sed -n 's/^[[:space:]]*identifier:[[:space:]]*"\([^"]*\)".*/\1/p' "$SRC/conf.yml" | head -1)"
  [ -n "$identifier" ] || die "conf.yml: missing identifier."

  # Match the owner the panel actually runs as (same logic as the installer: never assume www-data — RHEL...
  local web_owner
  web_owner="$(sudo -n stat -c '%U:%G' "$panel/storage" 2>/dev/null || echo "www-data:www-data")"
  if [ "${web_owner%%:*}" = "root" ] || [ -z "$web_owner" ]; then
    web_owner="www-data:www-data"
  fi

  local version icon icon_ext icon_url
  version="$(sed -n 's/^[[:space:]]*version:[[:space:]]*"\([^"]*\)".*/\1/p' "$SRC/conf.yml" | head -1)"
  # Extension icon: conf.yml holds a repo-relative path (e.g. assets/logo.png); Blueprint serves it from...
  icon="$(sed -n 's/^[[:space:]]*icon:[[:space:]]*"\([^"]*\)".*/\1/p' "$SRC/conf.yml" | head -1)"
  icon_ext="${icon##*.}"
  [ -n "$icon" ] || icon_ext="jpg"
  icon_url="/assets/extensions/$identifier/icon.$icon_ext"

  local installed_view="$panel/resources/views/admin/extensions/$identifier/index.blade.php"
  # Concatenated rather than brace-expanded: a literal {identifier} token anywhere in a packaged file is rewritten by
  # Blueprint's installer placeholder pass, and that would mangle this path inside the installed copy.
  local installed_ctl="$panel/app/Http/Controllers/Admin/Extensions/$identifier/$identifier""ExtensionController.php"
  local installed_conf="$panel/.blueprint/extensions/$identifier/private/.store/conf.yml"
  local installed_css="$panel/.blueprint/extensions/$identifier/assets/admin.style.css"
  local installed_icon="$panel/.blueprint/extensions/$identifier/assets/icon.$icon_ext"

  local tmpv="$(mktemp)"
  {
    # Trim the header's last line back to its yield: Blueprint glues the body's opening `<?php` onto it, so re-appending
    # the view without trimming would open PHP twice on the second sync and break the page.
    sed -n '1,/extension\.description/p' "$installed_view" 2>/dev/null \
      | sed -E -e 's~^(.*@yield\(.extension\.description.\)).*$~\1~' \
               -e 's~\$EXTENSION_VERSION = ".*";~\$EXTENSION_VERSION = "'"${version:-unknown}"'";~' \
               -e 's~\$EXTENSION_ICON = ".*";~\$EXTENSION_ICON = "'"$icon_url"'";~'
    printf '\n'
    cat "$SRC/view.blade.php"
    printf '\n@endsection\n'
  } > "$tmpv"

  sudo -n cp "$tmpv" "$installed_view" \
    && sudo -n chown "$web_owner" "$installed_view" \
    && sudo -n rsync -a "$SRC/app/AdminController.php" "$installed_ctl" \
    && sudo -n rsync -a "$SRC/conf.yml" "$installed_conf" \
    && sudo -n rsync -a "$SRC/admin.style.css" "$installed_css" \
    && sudo -n chown "$web_owner" "$installed_ctl" "$installed_conf" "$installed_css" \
    || die "syncing admin files failed (is the extension installed?)."

  if [ -n "$icon" ] && [ -f "$SRC/$icon" ]; then
    sudo -n rsync -a "$SRC/$icon" "$installed_icon" \
      && sudo -n chown "$web_owner" "$installed_icon" \
      || die "syncing extension icon failed."
  fi

  rm -f "$tmpv"

  ( cd "$panel" && sudo -n php artisan view:clear >/dev/null 2>&1; true )

  # Keep Blueprint's admin css import alive (idempotent).
  local bp_css="$panel/.blueprint/extensions/blueprint/assets/admin.extensions.css"
  local import_line="@import url(/assets/extensions/$identifier/admin.style.css);"
  if [ -f "$bp_css" ] && ! sudo -n grep -qF "$import_line" "$bp_css"; then
    printf '%s\n' "$import_line" | sudo -n tee -a "$bp_css" >/dev/null
  fi
}

# `mi css [--check]` --check fail when root.css is stale (hand-edited or not regenerated), for CI; the file is...
cmd_css() {
  if ! arg_has --check "$@"; then
    node "$SRC/tools/build-css.mjs"
    return 0
  fi

  local before
  before="$(mktemp)"
  cp "$SRC/root.css" "$before" 2>/dev/null || : > "$before"
  node "$SRC/tools/build-css.mjs" >/dev/null || die "css build failed."

  if diff -q "$before" "$SRC/root.css" >/dev/null 2>&1; then
    rm -f "$before"
    ok "css: root.css matches components/styles (regenerated)"
    return 0
  fi

  rm -f "$before"
  warn "css: root.css was out of date — it has been regenerated from components/styles"
  printf '%s\n' "  commit the regenerated root.css" | sed 's/^/    /'
  return 1
}

# ───────────────────────────── mi release ─────────────────── Computes the next version from the commit...
cmd_release() {
  local bump="" do_tag=0 dry=0
  local arg
  for arg in "$@"; do
    case "$arg" in
      major|minor|patch) bump="$arg" ;;
      --tag)             do_tag=1 ;;
      --dry-run|-n)      dry=1 ;;
      *) die "mi release: unknown argument '$arg' (use major|minor|patch [--tag] [--dry-run])" ;;
    esac
  done

  [ -f "$SRC/conf.yml" ] || die "conf.yml not found."
  command -v git >/dev/null || die "git not available."

  local cur
  cur="$(sed -n 's/^[[:space:]]*version:[[:space:]]*"\([^"]*\)".*/\1/p' "$SRC/conf.yml" | head -1)"
  [[ "$cur" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "conf.yml version '$cur' is not X.Y.Z."
  local maj=${cur%%.*} rest=${cur#*.}
  local min=${rest%%.*} pat=${rest#*.}

  # Version scheme: 0.<feat-count>.<fix-count> — counts over ALL history (deterministic, matches how conf.yml...
  local subjects=()
  while IFS= read -r s; do [ -n "$s" ] && subjects+=("$s"); done < <(
    git -C "$SRC" log --pretty=format:%s 2>/dev/null
  )
  [ "${#subjects[@]}" -gt 0 ] || die "No commits found — nothing to release."

  local nfeat=0 nfix=0 s
  for s in "${subjects[@]}"; do
    case "$s" in
      feat*:*|feat:*|feat\(*:*) nfeat=$(( nfeat + 1 )) ;;
      fix*:*)                   nfix=$(( nfix + 1 )) ;;
    esac
  done

  if [ "$bump" = "major" ]; then
    maj=$(( maj + 1 ))
  fi
  min=$nfeat
  pat=$nfix
  local next="$maj.$min.$pat"

  [ "$next" != "$cur" ] || die "Version already at $next (0 feat/fix commits added since)."

  # --- changelog entry ---
  local feats=() fixes=() others=()
  for s in "${subjects[@]}"; do
    case "$s" in
      feat*:*) feats+=("${s#*:}") ;;
      fix*:*)  fixes+=("${s#*:}") ;;
      chore*:*|chore:*) ;;
      *)       others+=("$s") ;;
    esac
  done

  local entry="\n## $next — $(date +%Y-%m-%d)\n"
  if [ "${#feats[@]}" -gt 0 ]; then
    entry+="### Features\n"
    for s in "${feats[@]}"; do entry+="- ${s# }\n"; done
    entry+="\n"
  fi
  if [ "${#fixes[@]}" -gt 0 ]; then
    entry+="### Fixes\n"
    for s in "${fixes[@]}"; do entry+="- ${s# }\n"; done
    entry+="\n"
  fi
  if [ "${#others[@]}" -gt 0 ]; then
    entry+="### Other\n"
    for s in "${others[@]}"; do entry+="- $s\n"; done
    entry+="\n"
  fi

  if [ "$dry" = 1 ]; then
    printf '%b' "$entry"
    info "dry run — nothing written; $cur would become $next ($nfeat feat, $nfix fix)"
    return 0
  fi

  # --- write files ---
  sed -i 's~^\([[:space:]]*version:[[:space:]]*\)"[^"]*"~\1"'"$next"'"~' "$SRC/conf.yml" \
    || die "failed to update conf.yml."
  sed -E "s~^(export const EXTENSION_VERSION = ).*;~\1\"$next\";~" \
    "$SRC/components/utils/constants.ts" > "$SRC/components/utils/constants.ts.tmp" \
    && mv "$SRC/components/utils/constants.ts.tmp" "$SRC/components/utils/constants.ts" \
    || die "failed to update components/utils/constants.ts."

  # Prepend to CHANGELOG.md (after the title line if present).
  local tmpcl="$(mktemp)"
  if [ -f "$SRC/CHANGELOG.md" ]; then
    { head -1 "$SRC/CHANGELOG.md"; printf '%b' "$entry"; tail -n +2 "$SRC/CHANGELOG.md"; } > "$tmpcl"
  else
    { printf '# Changelog\n\n'; printf '%b' "$entry"; } > "$tmpcl"
  fi
  mv "$tmpcl" "$SRC/CHANGELOG.md"

  ok "version: $cur → $next ($nfeat feat, $nfix fix)"
  info "updated: conf.yml, components/utils/constants.ts, CHANGELOG.md"

  if [ "$do_tag" = 1 ]; then
    git -C "$SRC" add conf.yml components/utils/constants.ts CHANGELOG.md
    git -C "$SRC" commit -m "chore: release $next" \
      || die "git commit failed."
    git -C "$SRC" tag -a "v$next" -m "Release $next" \
      || die "git tag failed."
    ok "committed and tagged v$next — push with: git push --follow-tags"
  else
    info "review the diff, then run: git add -A && git commit -m 'chore: release $next'"
    info "or re-run with --tag to commit + tag automatically."
  fi
}

# ───────────────────────────── mi update ──────────────────── Explicit version bump — the opposite of `mi...
cmd_update() {
  local nMaj=0 nMin=0 nPat=0 gaveM=0 gavem=0 gavep=0 do_tag=0 dry=0 arg
  local for_commit="" subject="" cdesc="" ckind=""
  for_commit="$(arg_val --commit "$@" || true)"
  [ -n "$for_commit" ] || for_commit="$(arg_val --for-commit "$@" || true)"

  while [ "$#" -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --commit|--for-commit) [ "$#" -gt 0 ] && shift ;;
      -M|--major) gaveM=1; nMaj=1; [ "$#" -gt 0 ] && [[ "$1" =~ ^[0-9]+$ ]] && { nMaj="$1"; shift; } ;;
      -m|--minor) gavem=1; nMin=1; [ "$#" -gt 0 ] && [[ "$1" =~ ^[0-9]+$ ]] && { nMin="$1"; shift; } ;;
      -p|--patch) gavep=1; nPat=1; [ "$#" -gt 0 ] && [[ "$1" =~ ^[0-9]+$ ]] && { nPat="$1"; shift; } ;;
      --tag)        do_tag=1 ;;
      --dry-run|-n) dry=1 ;;
      major)        gaveM=1; nMaj=$(( nMaj + 1 )) ;;
      minor)        gavem=1; nMin=$(( nMin + 1 )) ;;
      patch)        gavep=1; nPat=$(( nPat + 1 )) ;;
      *) die "mi update: unknown argument '$arg' (use -M|-m|-p [n] [--commit <sha>] [--tag] [--dry-run])" ;;
    esac
  done

  # --commit: classify one commit's subject, so the pre-push hook and humans share the same feat/minor, fix/patch, chore/major mapping.
  if [ -n "$for_commit" ]; then
    command -v git >/dev/null || die "git not available."
    subject="$(git -C "$SRC" log -1 --pretty=%s "$for_commit" 2>/dev/null || true)"
    [ -n "$subject" ] || die "mi update: no commit '$for_commit' in this repository."

    # The leading word decides the bump; lowercasing it keeps the match case-insensitive without touching the description.
    local ctype
    ctype="$(printf '%s' "$subject" | sed -nE 's/^[[:space:]]*([A-Za-z]+)(\([^)]*\))?!?:.*/\1/p' | tr 'A-Z' 'a-z')"
    case "$ctype" in
      feat)  ckind="feat";  gavem=1; nMin=1 ;;
      fix)   ckind="fix";   gavep=1; nPat=1 ;;
      chore) ckind="chore"; gaveM=1; nMaj=1 ;;
      *)     die "mi update: '$(printf '%.60s' "$subject")' is not a feat:/fix:/chore: commit — nothing to bump." ;;
    esac
    cdesc="$(printf '%s' "$subject" | sed -E 's/^[[:space:]]*[A-Za-z]+(\([^)]*\))?!?:[[:space:]]*//')"
  fi

  [ "$gaveM$gavem$gavep" != "000" ] || die "mi update: nothing to bump (pass -M, -m, -p or --commit <sha>)."
  [ -f "$SRC/conf.yml" ] || die "conf.yml not found."

  local cur maj rest min pat
  cur="$(sed -n 's/^[[:space:]]*version:[[:space:]]*"\([^"]*\)".*/\1/p' "$SRC/conf.yml" | head -1)"
  [[ "$cur" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "conf.yml version '$cur' is not X.Y.Z."
  maj=${cur%%.*}; rest=${cur#*.}; min=${rest%%.*}; pat=${rest#*.}

  if [ "$gaveM" = 1 ]; then maj=$(( maj + nMaj )); min=0; pat=0; fi
  if [ "$gavem" = 1 ]; then min=$(( min + nMin )); pat=0; fi
  if [ "$gavep" = 1 ]; then pat=$(( pat + nPat )); fi
  local next="$maj.$min.$pat"
  [ "$next" != "$cur" ] || die "Version already at $next."

  local entry
  case "$ckind" in
    feat)  entry="\n## $next — $(date +%Y-%m-%d)\n\n### Features\n- $cdesc\n" ;;
    fix)   entry="\n## $next — $(date +%Y-%m-%d)\n\n### Fixes\n- $cdesc\n" ;;
    chore) entry="\n## $next — $(date +%Y-%m-%d)\n\n### Changed\n- $cdesc\n" ;;
    *)     entry="\n## $next — $(date +%Y-%m-%d)\n\n### Changed\n- version bumped $cur → $next\n" ;;
  esac

  if [ "$dry" = 1 ]; then
    printf '%b' "$entry"
    info "dry run — nothing written; $cur would become $next"
    return 0
  fi

  sed -i 's~^\([[:space:]]*version:[[:space:]]*\)"[^"]*"~\1"'"$next"'"~' "$SRC/conf.yml" \
    || die "failed to update conf.yml."
  sed -E "s~^(export const EXTENSION_VERSION = ).*;~\1\"$next\";~" \
    "$SRC/components/utils/constants.ts" > "$SRC/components/utils/constants.ts.tmp" \
    && mv "$SRC/components/utils/constants.ts.tmp" "$SRC/components/utils/constants.ts" \
    || die "failed to update components/utils/constants.ts."

  # Insert the new section above the newest existing one, but below any intro/ banner at the top of the file...
  local anchor=1 tmpcl="$(mktemp)"
  if [ -f "$SRC/CHANGELOG.md" ]; then
    local banner_line
    banner_line="$(grep -n '^!\[' "$SRC/CHANGELOG.md" | head -1 | cut -d: -f1)"
    [ -n "$banner_line" ] && anchor="$banner_line"
    { head -n "$anchor" "$SRC/CHANGELOG.md"; printf '%b' "$entry"; tail -n +"$(( anchor + 1 ))" "$SRC/CHANGELOG.md"; } > "$tmpcl"
  else
    { printf '# Changelog\n\n'; printf '%b' "$entry"; } > "$tmpcl"
  fi
  mv "$tmpcl" "$SRC/CHANGELOG.md"

  ok "version: $cur → $next${ckind:+ ($ckind: $cdesc)}"
  info "updated: conf.yml, components/utils/constants.ts, CHANGELOG.md"

  if [ "$do_tag" = 1 ]; then
    git -C "$SRC" add conf.yml components/utils/constants.ts CHANGELOG.md
    git -C "$SRC" commit -m "chore: release $next" \
      || die "git commit failed."
    git -C "$SRC" tag -a "v$next" -m "Release $next" \
      || die "git tag failed."
    ok "committed and tagged v$next — push with: git push --follow-tags"
  else
    info "review the diff, then commit, or re-run with --tag."
  fi
}

# ───────────────────────────── mi coverage ──────────────────── Maps app/ classes against test suites: which...
cmd_coverage() {
  local classes=() f base
  local min
  min="$(arg_val --min "$@" || true)"
  case "$min" in
    ""|[0-9]|[0-9][0-9]|100) ;;
    *) die "mi coverage --min expects 0-100 (got '$min')" ;;
  esac
  while IFS= read -r f; do
    base="$(basename "$f" .php)"
    [ "$base" = "helpers" ] && continue
    classes+=("$base")
  done < <(find "$SRC/app" -name '*.php' -type f | sort)

  local tested=0 untested=0 c
  local uncovered=()
  if [ "$QUIET" = 0 ] && [ "$JSON" = 0 ]; then
    printf '%s▲%s %smi coverage%s — %d app classes\n\n' \
      "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "${#classes[@]}"
  fi

  for c in "${classes[@]}"; do
    if grep -rql "$c" "$SRC/tests/manual" 2>/dev/null; then
      tested=$(( tested + 1 ))
      [ "$TTY" = 1 ] && printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$c"
    else
      untested=$(( untested + 1 ))
      uncovered+=("$c")
    fi
  done

  if [ "$TTY" = 1 ]; then
    # TTY: only print the gap list (the checked set is noise)
    :
  fi

  if [ "${#uncovered[@]}" -gt 0 ] && [ "$QUIET" = 0 ] && [ "$JSON" = 0 ]; then
    printf '%s── no test references these classes ──%s\n' "$C_YELLOW" "$C_RESET"
    for c in "${uncovered[@]}"; do
      printf '  %s·%s %s\n' "$C_YELLOW" "$C_RESET" "$c"
    done
  fi

  local pct=$(( tested * 100 / (${#classes[@]} > 0 ? ${#classes[@]} : 1) ))

  if [ "$JSON" = 1 ]; then
    printf '{"classes":%d,"covered":%d,"uncovered":%d,"percent":%d,"uncovered_classes":[' \
      "${#classes[@]}" "$tested" "$untested" "$pct"
    local first=1
    for c in "${uncovered[@]}"; do
      [ "$first" = 1 ] || printf ','
      first=0
      printf '"%s"' "$c"
    done
    printf ']}\n'
  else
    printf '\n%s── summary ────────────────────────────%s\n' "$C_DIM" "$C_RESET"
    printf '  %s✓ %d covered%s  %s· %d uncovered%s  (%d%%)\n' \
      "$C_GREEN" "$tested" "$C_RESET" \
      "$C_YELLOW" "$untested" "$C_RESET" "$pct"
  fi

  if [ -n "$min" ]; then
    [ "$pct" -ge "$min" ] \
      || die "coverage ${pct}% is below the --min ${min}% threshold."
    [ "$JSON" = 1 ] || ok "coverage ${pct}% meets --min ${min}%"
    return 0
  fi

  [ "$untested" -eq 0 ]
}

# ───────────────────────────── mi smoke ──────────────────────── Post-deploy health check against the local...
cmd_smoke() {
  local panel="${PANEL_DIR:-/var/www/pterodactyl}" fails=0
  local url_override
  url_override="$(arg_val --url "$@" || true)"

  local app_url=""
  if [ -f "$panel/.env" ]; then
    app_url="$(sudo -n sed -n 's/^APP_URL="\?\([^"\n]*\)"\?$/\1/p' "$panel/.env" 2>/dev/null | head -1)"
  fi
  # --url wins: lets you smoke-test a remote panel from any machine.
  [ -n "$url_override" ] && app_url="$url_override"
  [ -n "$app_url" ] \
    || die "No APP_URL in $panel/.env — pass --url https://your-panel."

  local identifier="modpackinstaller"
  local base="${app_url%/}"
  local panel_code="" admin_code="" api_code="" css_code=""
  local datadir="" datadir_state="unchecked"
  local bundle_count=0 bundle_state="unchecked"

  if [ "$QUIET" = 0 ] && [ "$JSON" = 0 ]; then
    printf '%s▲%s %smi smoke%s — %s\n\n' \
      "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "$base"
  fi

  # 1. Panel is up at all
  local code
  code="$(curl -sk -o /dev/null -w '%{http_code}' --max-time 10 "$base/")"
  panel_code="$code"
  if [ "$code" = 200 ] || [ "$code" = 302 ]; then
    okq "panel responds ($code)"
  else
    warn "panel responded $code (expected 200/302)"; fails=$(( fails + 1 ))
  fi

  # 2.
  code="$(curl -sk -o /dev/null -w '%{http_code}' --max-time 10 "$base/admin/extensions/$identifier")"
  admin_code="$code"
  if [ "$code" = 500 ]; then
    warn "admin page 500 — check storage/logs/laravel-*.log"; fails=$(( fails + 1 ))
  else
    okq "admin page not erroring ($code)"
  fi

  # 3. Client API route exists (unauthenticated → 401, never 404/500)
  code="$(curl -sk -o /dev/null -w '%{http_code}' --max-time 10 \
    "$base/api/client/extensions/$identifier/catalog/providers")"
  api_code="$code"
  case "$code" in
    401|403|302) okq "api route guarded ($code)" ;;
    404)     warn "api route 404 — router not registered/cached"; fails=$(( fails + 1 )) ;;
    *)       warn "api route responded $code"; fails=$(( fails + 1 )) ;;
  esac

  # 4. Admin CSS asset serves through the web server
  code="$(curl -sk -o /dev/null -w '%{http_code}' --max-time 10 \
    "$base/assets/extensions/$identifier/admin.style.css")"
  css_code="$code"
  if [ "$code" = 200 ]; then
    okq "admin css serves"
  else
    warn "admin css responded $code (symlink/nginx issue?)"; fails=$(( fails + 1 ))
  fi

  # 5. Data dir writable by php-fpm user
  datadir="$(sudo -n php -r '
require "'"$panel"'/vendor/autoload.php";
$c = new Illuminate\Config\Repository;
$f = "'"$panel"'/config/modpackinstaller.php";
$d = is_file($f) ? (require $f) : [];
echo $d["data_dir"] ?? "/var/lib/pterodactyl/modpack-installer";
' 2>/dev/null || echo "/var/lib/pterodactyl/modpack-installer")"
  if sudo -n test -d "$datadir" && sudo -n test -w "$datadir"; then
    datadir_state="writable"
    okq "data dir writable ($datadir)"
  elif sudo -n test -d "$datadir"; then
    datadir_state="not-writable"
    warn "data dir exists but not writable: $datadir"; fails=$(( fails + 1 ))
  else
    datadir_state="absent"
    info "data dir not created yet ($datadir) — ok until first install"
  fi

  # 6. Panel frontend bundle. The page can answer 200 and still render blank, because the panel's build deletes every
  # JS asset before compiling — a failed compile leaves the whole UI empty.
  bundle_count="$(find "$panel/public/assets" -maxdepth 1 -type f -name '*.js' 2>/dev/null | wc -l | tr -d ' ')"
  if [ "${bundle_count:-0}" -gt 0 ]; then
    bundle_state="present"
    okq "frontend bundle present ($bundle_count file(s))"
  else
    bundle_state="missing"
    warn "no public/assets/*.js — the panel UI would render blank; run: cd $panel && yarn run build:production"
    fails=$(( fails + 1 ))
  fi

  if [ "$JSON" = 1 ]; then
    printf '{"base":"%s","failures":%d,"panel":"%s","admin":"%s","api":"%s","css":"%s","data_dir":{"path":"%s","state":"%s"},"frontend":{"bundles":%d,"state":"%s"}}\n' \
      "$base" "$fails" "$panel_code" "$admin_code" "$api_code" "$css_code" \
      "$datadir" "$datadir_state" "${bundle_count:-0}" "$bundle_state"
  fi

  if [ "$fails" -gt 0 ]; then
    die "smoke check failed ($fails issue(s))."
  fi
  okq "smoke passed — deployment looks healthy"
}

# ───────────────────────────── mi doctor ────────────────────
# Panel compatibility check. A Pterodactyl update can rename a class, move a
# view or drop a route the extension relies on; this verifies every
# integration point still resolves, so a breaking update is caught before it
# 500s. Exit 1 on any failure — gaps are usually fixed by `mi install`
# (re-registers the extension) or `mi build` (re-publishes assets).
# `--json` prints a machine-readable summary.
cmd_doctor() {
  local panel="${PANEL_DIR:-/var/www/pterodactyl}" fails=0
  local identifier
  identifier="$(sed -n 's/^[[:space:]]*identifier:[[:space:]]*"\([^"]*\)".*/\1/p' "$SRC/conf.yml" | head -1)"
  [ -n "$identifier" ] || die "conf.yml: missing identifier."

  local json_classes=() json_views=()

  # In --json mode the progress log goes to stderr so stdout stays one object.
  if [ "$JSON" = 1 ]; then exec 3>&1 1>&2; fi

  if [ "$JSON" = 0 ]; then
    printf '%s▲%s %smi doctor%s — panel compatibility check\n\n' \
      "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET"
  fi

  # Panel present
  local panel_ok=0
  if [ -f "$panel/artisan" ] && [ -f "$panel/vendor/autoload.php" ]; then
    panel_ok=1; okq "panel found at $panel"
  else
    fails=$(( fails + 1 )); warn "panel not found at $panel — run 'mi install'"
  fi

  # Versions
  local panel_ver="" bp_ver=""
  [ -f "$panel/config/app.php" ] && \
    panel_ver="$(sed -n "s/.*'version'[[:space:]]*=>[[:space:]]*'\([^']*\)'.*/\1/p" "$panel/config/app.php" | head -1)"
  bp_ver="$(sudo -n blueprint -version 2>/dev/null | head -1 || true)"
  [ -n "$bp_ver" ] || bp_ver="$(cat "$panel/.blueprint/extensions/blueprint/private/db/version" 2>/dev/null || true)"
  [ -n "$panel_ver" ] && info "pterodactyl $panel_ver"
  if [ -n "$bp_ver" ]; then info "blueprint $bp_ver"; else warn "blueprint version unknown (is Blueprint installed?)"; fi

  # Integration points: classes + views, via the panel's own autoloader.
  if [ "$panel_ok" = 1 ]; then
    local tmpc php_out
    tmpc="$(mktemp)"
    cat > "$tmpc" <<'PHP'
<?php
require $argv[1] . '/vendor/autoload.php';
$id = $argv[2];
$classes = [
    'Pterodactyl\Http\Controllers\Controller',
    'Pterodactyl\Http\Controllers\Api\Client\ClientApiController',
    'Pterodactyl\Http\Middleware\Activity\ServerSubject',
    'Pterodactyl\Http\Middleware\Api\Client\Server\AuthenticateServerAccess',
    'Pterodactyl\Http\Middleware\Api\Client\Server\ResourceBelongsToServer',
    'Pterodactyl\Models\Server',
    'Pterodactyl\Models\Node',
    'Pterodactyl\Services\Helpers\SoftwareVersionService',
    'Pterodactyl\BlueprintFramework\Libraries\ExtensionLibrary\Admin\BlueprintAdminLibrary',
];
foreach ($classes as $c) {
    $ok = class_exists($c) || interface_exists($c) || trait_exists($c);
    echo ($ok ? 'OK' : 'MISS') . "\tclass\t" . $c . "\n";
}
$views = [
    'resources/views/layouts/admin.blade.php',
    'resources/views/blueprint/admin/template.blade.php',
    'resources/views/admin/extensions/' . $id . '/index.blade.php',
];
foreach ($views as $v) {
    echo (is_file($argv[1] . '/' . $v) ? 'OK' : 'MISS') . "\tview\t" . $v . "\n";
}
PHP
    php_out="$(sudo -n php "$tmpc" "$panel" "$identifier" 2>/dev/null || true)"
    rm -f "$tmpc"

    if [ -z "$php_out" ]; then
      fails=$(( fails + 1 )); warn "could not introspect the panel (sudo or autoload failed)"
    else
      local state kind name
      while IFS=$'\t' read -r state kind name; do
        [ -n "$name" ] || continue
        if [ "$state" = OK ]; then
          if [ "$kind" = class ]; then json_classes+=("\"$name\""); else json_views+=("\"$name\""); fi
          okq "$kind: $name"
        else
          fails=$(( fails + 1 ))
          if [ "$kind" = class ]; then json_classes+=("\"!$name\""); else json_views+=("\"!$name\""); fi
          warn "$kind missing: $name — a panel update moved it; run 'mi install'"
        fi
      done <<< "$php_out"
    fi
  fi

  # Extension installed + published assets
  if [ -d "$panel/.blueprint/extensions/$identifier" ]; then
    okq "extension installed ($identifier)"
  else
    fails=$(( fails + 1 )); warn "extension not installed — run 'mi install'"
  fi
  local css="$panel/public/assets/extensions/$identifier/admin.style.css"
  if [ -e "$css" ]; then
    okq "admin assets published"
  else
    fails=$(( fails + 1 )); warn "admin assets missing ($css) — run 'mi build'"
  fi

  # Install-record data dir
  local datadir="/var/lib/pterodactyl/modpack-installer"
  if sudo -n test -d "$datadir" && sudo -n test -w "$datadir"; then
    okq "data dir writable ($datadir)"
  elif sudo -n test -d "$datadir"; then
    fails=$(( fails + 1 )); warn "data dir exists but not writable: $datadir"
  else
    info "data dir not created yet ($datadir) — ok until first install"
  fi

  if [ "$JSON" = 1 ]; then
    exec 1>&3 3>&-   # restore stdout for the machine-readable summary
    printf '{"panel":"%s","panel_version":"%s","blueprint_version":"%s","failures":%d,"classes":[%s],"views":[%s]}\n' \
      "$panel" "$panel_ver" "$bp_ver" "$fails" \
      "$(IFS=,; echo "${json_classes[*]}")" "$(IFS=,; echo "${json_views[*]}")"
  fi

  [ "$fails" -eq 0 ] || die "doctor: $fails compatibility issue(s) — run 'mi install'."
  okq "doctor: all integration points resolve"
}

# ───────────────────────────── mi db:reset ──────────────────── Wipes extension-owned local state: install...
cmd_dbreset() {
  local wipe_settings=0 dry=0
  if arg_has --all "$@" || arg_has -a "$@"; then wipe_settings=1; fi
  if arg_has --dry-run "$@" || arg_has -n "$@"; then dry=1; fi

  local panel="${PANEL_DIR:-/var/www/pterodactyl}"
  local datadir="${MI_DATA_DIR:-/var/lib/pterodactyl/modpack-installer}"

  info "Resetting extension state (records, history, catalog cache)"

  # Nothing is touched without this early exit — safe to read the plan first.
  if [ "$dry" = 1 ]; then
    info "dry run — nothing was removed"
    info "would remove: $datadir/installs.json, $datadir/history.json"
    info "would flush:  modpackinstaller:catalog:* cache keys"
    if [ "$wipe_settings" = 1 ]; then
      info "would delete: settings rows named modpackinstaller::*"
    else
      info "settings preserved (--all would delete them)"
    fi
    return 0
  fi

  if [ -d "$datadir" ]; then
    sudo -n rm -f "$datadir/installs.json" "$datadir/history.json" \
      || die "could not remove state files (sudo?)."
    ok "removed install records + history"
  else
    info "no data dir at $datadir — nothing on disk to wipe"
  fi

  # Catalog cache keys in the panel cache store (same scan pattern tools/build.sh uses)
  if [ -f "$panel/artisan" ]; then
    sudo -n php -r '
require "'"$panel"'/vendor/autoload.php";
$app = require "'"$panel"'/bootstrap/app.php";
$kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);
$kernel->bootstrap();
try {
  $store = $app->make("cache")->store();
  $redis = $store->connection();
  [$cursor, $keys] = $redis->scan($cursor = 0, ["MATCH" => "modpackinstaller:catalog:*", "COUNT" => 100]);
  if (!empty($keys)) { $redis->del($keys); echo count($keys) . " cache keys removed\n"; }
  else { echo "no catalog cache keys\n"; }
} catch (Throwable $e) { echo "cache flush skipped: " . $e->getMessage() . "\n"; }
' || warn "catalog cache flush failed (store unreachable?)"
  fi

  if [ "$wipe_settings" = 1 ]; then
    sudo -n php -r '
require "'"$panel"'/vendor/autoload.php";
$app = require "'"$panel"'/bootstrap/app.php";
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
$n = $app->make("db")->table("settings")
  ->where("name", "like", "modpackinstaller::%")->delete();
echo $n . " settings removed\n";
' || die "could not clear settings (sudo?)."
    ok "settings cleared"
  else
    info "settings preserved — pass --all to also wipe admin-page settings"
  fi

  ok "reset complete"
}

# ───────────────────────────── mi watch ─────────────────────── Live-rebuild loop: watches the source tree,...
cmd_watch() {
  if in_panel_dev_tree; then
    info "handing off to Blueprint's native watch (dev tree)"
    exec sudo -n blueprint -watch
  fi

  if ! in_panel_dev_tree && ! panel=$(panel_dir); then
    die "No panel found — mi watch needs a local panel to deploy to."
  fi

  info "watching for changes — Ctrl+C to stop"
  cmd_build || die "initial build failed."

  local watch_paths=("$SRC/app" "$SRC/components" "$SRC/config" \
    "$SRC/view.blade.php" "$SRC/admin.style.css" "$SRC/conf.yml" "$SRC/root.css")

  if command -v inotifywait >/dev/null 2>&1; then
    while true; do
      inotifywait -r -q -e close_write,moved_to,create \
        --exclude '(\.git|node_modules|\.build-cache)' \
        "${watch_paths[@]}" 2>/dev/null || die "watcher died."
      sleep 0.5
      printf '%s[..]%s change detected — rebuilding\n' "$C_BLUE" "$C_RESET"
      cmd_build || warn "build failed — waiting for next change"
    done
  elif command -v fswatch >/dev/null 2>&1; then
    fswatch -r -o --exclude '\.git|node_modules|\.build-cache' \
      "${watch_paths[@]}" | while read -r _; do
        printf '%s[..]%s change detected — rebuilding\n' "$C_BLUE" "$C_RESET"
        cmd_build || warn "build failed — waiting for next change"
      done
  else
    # Dependency-free polling fallback (2s fingerprint of mtimes+sizes).
    local snap="" prev="" i
    while true; do
      snap="$(find "${watch_paths[@]}" -type f \
        \( -path '*/.git/*' -o -path '*/node_modules/*' \) -prune -o \
        -printf '%p %T@ %s\n' 2>/dev/null | sort | md5sum)"
      if [ -n "$prev" ] && [ "$snap" != "$prev" ]; then
        printf '%s[..]%s change detected — rebuilding\n' "$C_BLUE" "$C_RESET"
        cmd_build || warn "build failed — waiting for next change"
      fi
      prev="$snap"
      sleep 2
    done
  fi
}

# ───────────────────────────── mi install ────────────────────── One-command panel install — wraps...
cmd_install() {
  [ -f "$SRC/tools/installer.sh" ] || die "tools/installer.sh not found."

  local install_panel
  install_panel="$(arg_val --panel-dir "$@" || true)"
  [ -n "$install_panel" ] || install_panel="$(panel_dir || true)"
  [ -n "$install_panel" ] && warn_stale_blueprint_lock "$install_panel"

  local env_args=() pd wu
  if arg_has --force "$@" || arg_has -f "$@"; then env_args+=(MI_FORCE=1); fi
  pd="$(arg_val --panel-dir "$@" || true)"
  [ -n "$pd" ] && env_args+=("PANEL_DIR=$pd")
  wu="$(arg_val --web-user "$@" || true)"
  [ -n "$wu" ] && env_args+=("MI_WEB_USER=$wu" "MI_WEB_GROUP=$wu")

  if [ "${#env_args[@]}" -gt 0 ]; then
    exec env ${env_args[@]+"${env_args[@]}"} bash "$SRC/tools/installer.sh"
  fi
  exec bash "$SRC/tools/installer.sh"
}

# ───────────────────────────── mi remove ───────────────────── Uninstalls the extension from the panel and deletes
# what `mi install` / `mi build` published there, so the next build starts from a clean panel. Dependencies are left
# alone on purpose: system packages, PHP extensions, Blueprint, this checkout and the `mi` symlink all survive —
# only the extension's own files go.
cmd_remove() {
  local panel="" identifier pd dry=0 yes=0 devtree=0 reply="" rel removed=0 registered=0
  local inst_dir inst_conf inst_assets inst_views inst_ctl inst_css dev_tree

  pd="$(arg_val --panel-dir "$@" || true)"
  if arg_has --dry-run "$@" || arg_has -n "$@"; then dry=1; fi
  if arg_has --yes "$@" || arg_has -y "$@"; then yes=1; fi
  if arg_has --dev-tree "$@"; then devtree=1; fi

  identifier="$(conf_identifier)"
  [ -n "$identifier" ] || die "conf.yml: missing identifier."

  if [ -n "$pd" ]; then
    panel="$pd"
  elif ! panel="$(panel_dir)"; then
    die "No Pterodactyl panel found — pass --panel-dir <path>."
  fi
  [ -d "$panel" ] || die "Panel directory '$panel' does not exist."
  command -v blueprint >/dev/null 2>&1 \
    || die "Blueprint is not on this host — there is nothing this extension built to remove."

  inst_dir="$panel/.blueprint/extensions/$identifier"
  inst_conf="$panel/config/$identifier.php"
  inst_assets="$panel/public/assets/extensions/$identifier"
  inst_views="$panel/resources/views/admin/extensions/$identifier"
  inst_ctl="$panel/app/Http/Controllers/Admin/Extensions/$identifier"
  inst_css="$panel/resources/scripts/blueprint/css/imported/$identifier.css"
  dev_tree="$panel/.blueprint/dev"

  if extension_installed "$panel"; then registered=1; fi

  printf '%s▲%s %smi remove%s — %s\n\n' "$C_CYAN" "$C_RESET" "$C_BOLD" "$C_RESET" "$panel"

  if [ "$registered" = 0 ] && [ ! -d "$inst_dir" ]; then
    ok "nothing to remove — '$identifier' is not installed here"
    return 0
  fi

  info "keeps: system packages, PHP extensions, Blueprint, this checkout"

  if [ "$dry" = 1 ]; then
    info "dry run — would run: blueprint -remove $identifier  (files, routes, css, panel rebuild)"
    [ -f "$inst_conf" ]   && info "dry run — would delete: config/$identifier.php"
    [ -d "$inst_assets" ] && info "dry run — would delete: public/assets/extensions/$identifier"
    [ -d "$inst_views" ]  && info "dry run — would delete: resources/views/admin/extensions/$identifier"
    [ -d "$inst_ctl" ]    && info "dry run — would delete: app/Http/Controllers/Admin/Extensions/$identifier"
    [ -f "$inst_css" ]    && info "dry run — would delete: resources/scripts/blueprint/css/imported/$identifier.css"
    [ -d "$inst_dir" ]    && info "dry run — would delete: .blueprint/extensions/$identifier"
    if [ "$devtree" = 1 ] && [ -d "$dev_tree" ]; then
      info "dry run — would delete: .blueprint/dev"
    fi
    return 0
  fi

  if [ "$yes" = 0 ]; then
    if [ "$TTY" != 1 ]; then
      die "non-interactive shell — re-run with --yes to confirm the removal."
    fi

    printf '%s[??]%s Remove the extension from %s? (y/N) ' "$C_YELLOW" "$C_RESET" "$panel"
    read -r reply
    case "$reply" in
      y|Y|yes|YES) ;;
      *) info "removal cancelled — nothing changed."; return 1 ;;
    esac
  fi

  if [ "$registered" = 1 ]; then
    info "uninstalling through Blueprint (extension files, routes, admin pages, panel rebuild)"
    ( cd "$panel" && sudo -n env USER_CONFIRMED_REMOVAL=yes blueprint -remove "$identifier" ) \
      || die "blueprint -remove failed — read its output above, then re-run."
    ok "extension uninstalled"
  fi

  # Copies we publish outside the extension's own folder (install-time placements and build syncs) survive a
  # Blueprint removal, so a later rebuild would mix new files with stale ones. Clear them here.
  for rel in \
    "config/$identifier.php" \
    "public/assets/extensions/$identifier" \
    "resources/views/admin/extensions/$identifier" \
    "app/Http/Controllers/Admin/Extensions/$identifier" \
    "resources/scripts/blueprint/css/imported/$identifier.css" \
    ".blueprint/extensions/$identifier"; do
    [ -e "$panel/$rel" ] || continue
    sudo -n rm -rf "$panel/$rel" || die "failed to delete $rel."
    removed=$(( removed + 1 ))
  done

  if [ "$removed" -gt 0 ]; then
    ok "cleared $removed leftover path(s)"
  else
    ok "no leftovers to clear"
  fi

  if [ -d "$dev_tree" ]; then
    case "$SRC/" in
      "$dev_tree/"*) info "kept .blueprint/dev — that is this checkout" ;;
      *)
        if [ "$devtree" = 1 ]; then
          sudo -n rm -rf "$dev_tree" && ok "removed .blueprint/dev"
        else
          # Left in place by design: a developer's clone can live there, and deleting a working tree unasked would be
          # destructive. It is stale state after a removal, so say so rather than leaving it silent.
          warn "kept .blueprint/dev — a full clone of this repo may live there"
          info "drop it with:  mi remove --dev-tree     (then install again from your checkout)"
        fi
        ;;
    esac
  fi

  # Removing an extension makes Blueprint rebuild the panel assets, and that build deletes every JS bundle before it
  # compiles. A failure there is invisible from here, so check the panel can still render.
  local bundle_count
  bundle_count="$(find "$panel/public/assets" -maxdepth 1 -type f -name '*.js' 2>/dev/null | wc -l | tr -d ' ')"
  if [ "${bundle_count:-0}" -gt 0 ]; then
    ok "panel frontend intact ($bundle_count bundle file(s))"
  else
    warn "the panel has no frontend bundle (public/assets/*.js) — server pages would render blank"
    info "rebuild it with:  cd $panel && yarn run build:production"
  fi

  ok "clean — '$identifier' is gone from the panel"
  info "build it again with: mi install   (or mi build from a checkout of this repo)"
}

# ───────────────────────────── mi version ───────────────────────── The version the panel's extension card...
cmd_version() {
  local v id
  v="$(sed -n 's/^[[:space:]]*version:[[:space:]]*"\([^"]*\)".*/\1/p' "$SRC/conf.yml" | head -1)"
  id="$(sed -n 's/^[[:space:]]*identifier:[[:space:]]*"\([^"]*\)".*/\1/p' "$SRC/conf.yml" | head -1)"

  if [ "$JSON" = 1 ]; then
    printf '{"name":"Addon Manager","version":"%s","identifier":"%s","path":"%s"}\n' \
      "$v" "$id" "$SRC"
    return 0
  fi
  printf '%sAddon Manager%s %s%s%s %s(%s)%s — %s\n' \
    "$C_BOLD" "$C_RESET" "$C_GREEN" "$v" "$C_RESET" \
    "$C_DIM" "$id" "$C_RESET" "$SRC"
}

