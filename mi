# `mi <command> --help` — usage for a single command.
cmd_usage() {
  case "${1:-}" in
    test) cat <<EOF
${C_BOLD}mi test${C_RESET} [<name>] [flags]
  <name>            suites whose file name contains this substring
  -f, --filter <s>  same as the positional filter
  -l, --list        list the suites that would run, then exit
  -x, --bail        stop at the first failing suite
  -v, --verbose     full output for failing suites
  -q, --quiet       hide progress and the ✓ list
      --json        JSON summary on stdout (failures go to stderr)
EOF
      ;;
    lint) cat <<EOF
${C_BOLD}mi lint${C_RESET} [flags]
      --fix         apply php-cs-fixer
      --only <s>    run one stage: syntax | blade | style | ts
      --no-ts       skip the TypeScript typecheck
EOF
      ;;
    check) cat <<EOF
${C_BOLD}mi check${C_RESET} [flags]
      --fast        lint + audit only (skip the test suites)
      --only <s>    run one stage: lint | audit | test
      --json        forward --json to the audit and the suites
EOF
      ;;
    audit) cat <<EOF
${C_BOLD}mi audit${C_RESET} [path...] [--json]
  Scans app/ by default; pass paths to narrow it. Exit 1 on findings.
EOF
      ;;
    build) cat <<EOF
${C_BOLD}mi build${C_RESET} [flags]
  -n, --dry-run     print the detected layout, source, panel and steps
      --css-only    regenerate root.css and stop
EOF
      ;;
    css) cat <<EOF
${C_BOLD}mi css${C_RESET} [--check]
      --check       exit 1 when root.css was stale (CI gate)
EOF
      ;;
    release) cat <<EOF
${C_BOLD}mi release${C_RESET} [major|minor|patch] [flags]
      --tag         commit + tag after bumping
  -n, --dry-run     show the next version and changelog, write nothing
EOF
      ;;
    update|bump) cat <<EOF
${C_BOLD}mi update${C_RESET} [flags]      explicit version bump (adds n, default 1)
  -M, --major [n]   major + n (resets minor and patch to 0)
  -m, --minor [n]   minor + n (resets patch to 0)
  -p, --patch [n]   patch + n
  -n, --dry-run     show the next version and changelog, write nothing
      --tag         commit + tag after bumping
      --commit <sha> bump one commit's worth (feat: minor, fix: patch, chore: major)

  Examples:  mi update -m 1   mi update -p 1   mi update -M 1 -m 2
  Unlike 'mi release', this does not read the commit history.
EOF
      ;;
    coverage) cat <<EOF
${C_BOLD}mi coverage${C_RESET} [flags]
      --min <pct>   exit non-zero below this percentage
      --json        JSON summary on stdout
EOF
      ;;
    smoke) cat <<EOF
${C_BOLD}mi smoke${C_RESET} [flags]
      --url <base>  check a panel other than the local APP_URL
      --json        JSON summary on stdout
EOF
      ;;
    doctor) cat <<EOF
${C_BOLD}mi doctor${C_RESET} [--json]
  Verifies the panel classes, views, extension install and published assets
  the extension depends on still resolve. Run after a Pterodactyl update;
  exit 1 on any gap. Fix with 'mi install' / 'mi build'.
EOF
      ;;
    db:reset|dbreset|reset) cat <<EOF
${C_BOLD}mi db:reset${C_RESET} [flags]
      --all         also delete the admin-page settings rows
  -n, --dry-run     print what would be removed instead
EOF
      ;;
    install) cat <<EOF
${C_BOLD}mi install${C_RESET} [flags]   (needs sudo)
      --force         reinstall over an existing install
      --panel-dir <p> panel path (default /var/www/pterodactyl)
      --web-user <u>  PHP-FPM user when auto-detection fails
EOF
      ;;
    remove|uninstall) cat <<EOF
${C_BOLD}mi remove${C_RESET} [flags]    (needs sudo)
  Uninstalls the extension from the panel and deletes everything
  'mi install' / 'mi build' published, so the next build starts clean.
  Dependencies stay: system packages, PHP extensions, Blueprint, this
  checkout and the 'mi' symlink are not touched.

  -y, --yes           skip the confirmation prompt
  -n, --dry-run       print what would be removed, change nothing
      --dev-tree      also drop <panel>/.blueprint/dev (kept by default,
                      since a dev clone may live there)
      --panel-dir <p> panel path (default /var/www/pterodactyl)
EOF
      ;;
    watch) cat <<EOF
${C_BOLD}mi watch${C_RESET}
  Build once, then redeploy on every change. In the panel dev tree it hands
  off to Blueprint's own watcher. Ctrl+C to stop.
EOF
      ;;
    install-hooks|hooks) cat <<EOF
${C_BOLD}mi hooks${C_RESET}                  Show the pre-push hook state and its toggles
${C_BOLD}mi hooks install${C_RESET}          Symlink tools/hooks/pre-push into .git/hooks
${C_BOLD}mi hooks remove${C_RESET}           Unlink it again
${C_BOLD}mi hooks checks on|off${C_RESET}    Run mi lint + mi audit + mi test before every push
${C_BOLD}mi hooks bump on|off${C_RESET}      Bump the version from the pushed commit messages
                        feat: → minor · fix: → patch · chore: → major (case-insensitive)

  Toggles are stored per clone in .git/config (mi.hooks.checks, mi.hooks.bump).
  Skip one push with MI_SKIP_CHECKS=1 / MI_SKIP_BUMP=1, or per command with
  git -c mi.hooks.bump=false push.
EOF
      ;;
    version) printf '%smi version%s [--json]\n' "$C_BOLD" "$C_RESET" ;;
    *) cmd_help ;;
  esac
}

# ───────────────────────────── dispatch ────────────────────────────
SECONDS=0
cmd="${1:-help}"
shift 2>/dev/null || true

# Global flags, valid for every subcommand.
QUIET=0
JSON=0
if arg_has --quiet "$@" || arg_has -q "$@"; then QUIET=1; fi
if arg_has --json "$@"; then JSON=1; fi

# `mi <cmd> --help` / `-h` → just that command's usage.
if [ "$cmd" != help ] && { arg_has --help "$@" || arg_has -h "$@"; }; then
  cmd_usage "$cmd"
  exit 0
fi

case "$cmd" in
  test)  cmd_test "$@" ;;
  lint)  cmd_lint "$@" ;;
  check) cmd_check "$@" ;;
  audit) cmd_audit "$@" ;;
  hooks)         if [ "$#" -eq 0 ]; then cmd_hooks status; else cmd_hooks "$@"; fi ;;
  install-hooks) if [ "$#" -eq 0 ]; then cmd_hooks install; else cmd_hooks "$@"; fi ;;
  build) cmd_build "$@" ;;
  install) cmd_install "$@" ;;
  remove|uninstall) cmd_remove "$@" ;;
  css)   cmd_css "$@" ;;
  release) cmd_release "$@" ;;
  update|bump) cmd_update "$@" ;;
  coverage) cmd_coverage "$@" ;;
  smoke) cmd_smoke "$@" ;;
  doctor) cmd_doctor "$@" ;;
  db:reset|dbreset|reset) cmd_dbreset "$@" ;;
  watch) cmd_watch "$@" ;;
  version|--version|-V) cmd_version ;;
  help|--help|-h) cmd_help ;;
  *) die "Unknown command: $cmd — try 'mi help'" ;;
esac
